      "primaryOutsideZoneTemplateId": "EXT0_REPLACE_WITH_1A_WITHOUT_RDS_FAILOVER"
    },
    "us-east-1b": {
      "primaryInZoneTemplateId": "EXT0_REPLACE_WITH_1B_AND_RDS_FAILOVER",
