{
  "annotations": { "list": [] },
  "description": "Live Mandate 18 usage, telemetry and SLO guardrail dashboard. CUR is retained separately for historical billing reconciliation.",
  "editable": true,
  "id": null,
  "panels": [
    { "type": "row", "title": "1. Live Data Transfer Usage", "id": 1, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "Storefront throughput", "id": 2,
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "refId": "A", "editorMode": "code", "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"frontend\"}[$__rate_interval]))", "range": true }]
    },
    {
      "type": "stat", "title": "NAT 1a to destination", "id": 3,
      "datasource": { "type": "cloudwatch", "uid": "mandate18-cloudwatch" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "refId": "A", "alias": "nat-1a", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToDestination", "dimensions": { "NatGatewayId": "nat-0b043c6cb1b44c240" }, "metricEditorMode": 0, "metricQueryType": 0, "statistic": "Sum", "period": "60", "matchExact": true }]
    },
    {
      "type": "stat", "title": "NAT 1b to destination", "id": 4,
      "datasource": { "type": "cloudwatch", "uid": "mandate18-cloudwatch" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "refId": "A", "alias": "nat-1b", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToDestination", "dimensions": { "NatGatewayId": "nat-0f857f477664c05af" }, "metricEditorMode": 0, "metricQueryType": 0, "statistic": "Sum", "period": "60", "matchExact": true }]
    },
    {
      "type": "timeseries", "title": "NAT Gateway data processed by direction", "id": 5,
      "datasource": { "type": "cloudwatch", "uid": "mandate18-cloudwatch" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "alias": "nat-1a to destination", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToDestination", "dimensions": { "NatGatewayId": "nat-0b043c6cb1b44c240" }, "metricEditorMode": 0, "metricQueryType": 0, "statistic": "Sum", "period": "60", "matchExact": true },
        { "refId": "B", "alias": "nat-1a to source", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToSource", "dimensions": { "NatGatewayId": "nat-0b043c6cb1b44c240" }, "metricEditorMode": 0, "metricQueryType": 0, "statistic": "Sum", "period": "60", "matchExact": true },
        { "refId": "C", "alias": "nat-1b to destination", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToDestination", "dimensions": { "NatGatewayId": "nat-0f857f477664c05af" }, "metricEditorMode": 0, "metricQueryType": 0, "statistic": "Sum", "period": "60", "matchExact": true },
        { "refId": "D", "alias": "nat-1b to source", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToSource", "dimensions": { "NatGatewayId": "nat-0f857f477664c05af" }, "metricEditorMode": 0, "metricQueryType": 0, "statistic": "Sum", "period": "60", "matchExact": true }
      ]
    },
    { "type": "row", "title": "2. Telemetry Volume and Persistent Storage", "id": 6, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "OpenTelemetry export volume", "id": 7,
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum(rate(otelcol_exporter_sent_log_records_total[$__rate_interval])) or vector(0)", "legendFormat": "Logs / s", "range": true },
        { "refId": "B", "editorMode": "code", "expr": "sum(rate(otelcol_exporter_sent_spans_total[$__rate_interval])) or vector(0)", "legendFormat": "Spans / s", "range": true },
        { "refId": "C", "editorMode": "code", "expr": "sum(rate(otelcol_exporter_sent_metric_points_total[$__rate_interval])) or vector(0)", "legendFormat": "Metric points / s", "range": true }
      ]
    },
    {
      "type": "table", "title": "Persistent volume usage", "id": 8,
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false, "reducer": [] } },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "kubelet_volume_stats_used_bytes{namespace=\"techx-corp-prod\"}", "format": "table", "instant": true },
        { "refId": "B", "editorMode": "code", "expr": "kubelet_volume_stats_capacity_bytes{namespace=\"techx-corp-prod\"}", "format": "table", "instant": true }
      ],
      "transformations": [{ "id": "labelsToFields", "options": {} }]
    },
    { "type": "row", "title": "3. SLO Guardrails", "id": 9, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "Checkout end-to-end latency p95 and p99", "id": 10,
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 500 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend\",span_name=\"POST /api/checkout\"}[$__rate_interval])))", "legendFormat": "Checkout p95", "range": true },
        { "refId": "B", "editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend\",span_name=\"POST /api/checkout\"}[$__rate_interval])))", "legendFormat": "Checkout p99", "range": true }
      ]
    },
    {
      "type": "stat", "title": "Checkout success rate", "id": 11,
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 99 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "refId": "A", "editorMode": "code", "expr": "100 * (1 - ((sum(rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_name=\"POST /api/checkout\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_name=\"POST /api/checkout\"}[$__rate_interval])), 0.000001)))", "range": true }]
    },
    {
      "type": "stat", "title": "Ready workload pods", "id": 12,
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "refId": "A", "editorMode": "code", "expr": "sum(kube_pod_status_ready{namespace=\"techx-corp-prod\",condition=\"true\"})", "range": true }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mandate-18", "finops", "live-usage", "nat"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Directive 18 — Live Usage Evidence",
  "uid": "directive-18-live-usage",
  "version": 2
}
