    { "type": "stat", "title": "Browse success rate (SLO ≥ 99.5%)", "id": 2, "datasource": { "type": "prometheus", "uid": "webstore-metrics" }, "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 }, "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 99.5 }] } }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }, "targets": [{ "refId": "A", "expr": "100 * (1 - (sum(rate(traces_span_metrics_duration_milliseconds_count{service_name=\"frontend\", span_name=~\"render route.*|GET /products/.*|GET /api/products/.*\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_duration_milliseconds_count{service_name=\"frontend\", span_name=~\"render route.*|GET /products/.*|GET /api/products/.*\"}[$__rate_interval])), 0.000001))", "range": true }] },
    { "type": "stat", "title": "Browse p95 latency (SLO < 1 s)", "id": 3, "datasource": { "type": "prometheus", "uid": "webstore-metrics" }, "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 }, "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1000 }] } }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend\", span_name=~\"GET /products/.*|GET /api/products/.*|render route /product.*\"}[$__rate_interval])))", "range": true }] },
    { "type": "stat", "title": "Cart success rate (SLO ≥ 99.5%)", "id": 4, "datasource": { "type": "prometheus", "uid": "webstore-metrics" }, "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 }, "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 99.5 }] } }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }, "targets": [{ "refId": "A", "expr": "100 * (1 - (sum(rate(traces_span_metrics_duration_milliseconds_count{service_name=\"cart\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_duration_milliseconds_count{service_name=\"cart\"}[$__rate_interval])), 0.000001))", "range": true }] },
    { "type": "stat", "title": "Checkout success rate (SLO ≥ 99.0%)", "id": 5, "datasource": { "type": "prometheus", "uid": "webstore-metrics" }, "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 }, "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 99.0 }] } }, "overrides": [] }, "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }, "targets": [{ "refId": "A", "expr": "100 * (1 - ((sum(rate(traces_span_metrics_calls_total{service_name=\"frontend\", span_name=\"POST /api/checkout\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=\"frontend\", span_name=\"POST /api/checkout\"}[$__rate_interval])), 0.000001)))", "range": true }] },
    { "type": "row", "title": "2. NAT Gateway data processing", "id": 6, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false, "panels": [] },
    { "type": "timeseries", "title": "BytesOutToDestination by NAT Gateway", "description": "Same CloudWatch metric queried by the script. This is traffic from the NAT Gateway to the destination.", "id": 7, "datasource": { "type": "cloudwatch", "uid": "mandate18-cloudwatch" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }, "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 20 } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "targets": [{ "refId": "A", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToDestination", "dimensions": { "NatGatewayId": "nat-0b043c6cb1b44c240" }, "statistic": "Sum", "period": "60", "matchExact": true, "metricQueryType": 0, "queryMode": "Metrics", "legendFormat": "nat-0b043c6cb1b44c240" }, { "refId": "B", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToDestination", "dimensions": { "NatGatewayId": "nat-0f857f477664c05af" }, "statistic": "Sum", "period": "60", "matchExact": true, "metricQueryType": 0, "queryMode": "Metrics", "legendFormat": "nat-0f857f477664c05af" }] },
    { "type": "timeseries", "title": "BytesOutToSource by NAT Gateway", "description": "Same CloudWatch metric queried by the script. This is response traffic from destination back to the private workload.", "id": 8, "datasource": { "type": "cloudwatch", "uid": "mandate18-cloudwatch" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }, "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 20 } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "targets": [{ "refId": "A", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToSource", "dimensions": { "NatGatewayId": "nat-0b043c6cb1b44c240" }, "statistic": "Sum", "period": "60", "matchExact": true, "metricQueryType": 0, "queryMode": "Metrics", "legendFormat": "nat-0b043c6cb1b44c240" }, { "refId": "B", "region": "us-east-1", "namespace": "AWS/NATGateway", "metricName": "BytesOutToSource", "dimensions": { "NatGatewayId": "nat-0f857f477664c05af" }, "statistic": "Sum", "period": "60", "matchExact": true, "metricQueryType": 0, "queryMode": "Metrics", "legendFormat": "nat-0f857f477664c05af" }] },
    { "type": "row", "title": "3. VPC Flow Logs — input to Cross-AZ calculation", "id": 9, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "collapsed": false, "panels": [] },
    { "type": "table", "title": "Accepted egress Flow Log bytes by source AZ and destination", "description": "Exactly the Logs Insights query used in the script before it joins destination IPs to EC2 network interfaces to determine destination AZ.", "id": 10, "datasource": { "type": "cloudwatch", "uid": "mandate18-cloudwatch" }, "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 }, "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm" }, "targets": [{ "refId": "A", "region": "us-east-1", "queryMode": "Logs", "queryLanguage": "CWLI", "logGroups": [{ "name": "/aws/vpc/techx-prod-tf2-vpc/flow-logs", "arn": "arn:aws:logs:us-east-1:493499579600:log-group:/aws/vpc/techx-prod-tf2-vpc/flow-logs:*", "accountId": "493499579600" }], "expression": "fields @message\n| parse @message \"* * * * * * * * * * * * * * * *\" as version, accountId, interfaceId, srcAddr, dstAddr, srcPort, dstPort, protocol, packets, flowBytes, start, end, action, logStatus, sourceAzId, direction\n| filter action = \"ACCEPT\" and direction = \"egress\" and logStatus = \"OK\"\n| stats sum(flowBytes) as totalBytes by interfaceId, dstAddr, sourceAzId", "statsGroups": ["interfaceId", "dstAddr", "sourceAzId"], "metricQueryType": 0, "matchExact": false }] },
    { "type": "row", "title": "4. Telemetry export volume", "id": 11, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "collapsed": false, "panels": [] },
    { "type": "timeseries", "title": "OpenTelemetry Collector records exported", "id": 12, "datasource": { "type": "prometheus", "uid": "webstore-metrics" }, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 }, "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_exporter_sent_log_records_total[5m])) or vector(0)", "legendFormat": "Logs / s" }, { "refId": "B", "expr": "sum(rate(otelcol_exporter_sent_spans_total[5m])) or vector(0)", "legendFormat": "Spans / s" }, { "refId": "C", "expr": "sum(rate(otelcol_exporter_sent_metric_points_total[5m])) or vector(0)", "legendFormat": "Metric points / s" }] }
